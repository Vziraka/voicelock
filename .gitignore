# Python / uv
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code adapter output — .claude/skills/<name> are per-skill junctions
# pointing at .harness/skills/<name>, so there is exactly ONE copy to maintain
# and stale-copy drift is impossible. They are machine-local (absolute targets)
# and git would follow them and commit duplicates, so they stay out.
# A fresh clone re-creates them: see .harness/adapters/claude-code/README.md.
.claude/

# Secrets / local config (none declared yet — keep habit)
.env
.env.*
*.pem

# Audio / vault artifacts from local demos
*.wav
*.flac
*.vault
vaults/

# ...but committed test fixtures are the exception (Gate needs them on a clean checkout)
!tests/fixtures/voiceprint/*.wav

# Licence-restricted face fixture — fetched locally, deliberately NEVER committed.
# It is a White House press photograph whose own notice forbids reproduction or
# dissemination without written permission; committing it into git history is
# exactly that. Fetch it per tests/fixtures/face/README.md. The Apache-2.0
# vendor reference (portrait_expected_face_landmarks.pbtxt) IS committed beside it.
tests/fixtures/face/portrait.jpg
